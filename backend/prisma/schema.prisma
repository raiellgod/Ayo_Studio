generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum ArtistServiceType {
  TATTOO
  ART
  VOICE
}

enum StudioRequestType {
  FLASH_RESERVATION
  ARTWORK_RESERVATION
  PRODUCT_INTEREST
  TATTOO_CUSTOM
  ART_CUSTOM
  VOICE_CUSTOM
}

enum StudioRequestStatus {
  NEW
  CONTACTED
  QUOTED
  APPROVED
  COMPLETED
  CANCELLED
}

enum AdminRole {
  OWNER
  ADMIN
  EDITOR
}

model Professional {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  name        String
  role        String
  specialties String?
  description String?

  image        String?
  fullImage    String?
  profileImage String?

  isActive Boolean @default(true)

  services ProfessionalService[]
  flashes  Flash[]
  artworks Artwork[]
  products Product[]
  videos   Video[]

  studioRequests StudioRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProfessionalService {
  id      Int               @id @default(autoincrement())
  service ArtistServiceType

  professionalId Int
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([professionalId, service])
}

model Flash {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  description String?

  image String?

  price Decimal @db.Decimal(10, 2)

  categories String[]

  available Boolean @default(true)
  isActive  Boolean @default(true)

  artistId Int
  artist   Professional @relation(fields: [artistId], references: [id], onDelete: Cascade)

  studioRequests StudioRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([available])
  @@index([isActive])
}

model Artwork {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  name      String
  image     String
  type      String
  price     Int?
  available Boolean @default(true)
  isActive  Boolean @default(true)

  artistId Int
  artist   Professional @relation(fields: [artistId], references: [id], onDelete: Cascade)

  studioRequests StudioRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
}

model Product {
  id        Int     @id @default(autoincrement())
  slug      String  @unique
  name      String
  type      String
  image     String
  price     Float?
  available Boolean @default(true)
  isActive  Boolean @default(true)

  authorId Int?
  author   Professional? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  studioRequests StudioRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
}

model Video {
  id   Int    @id @default(autoincrement())
  slug String @unique
  name String

  video       String
  thumbnail   String?
  description String?

  isActive Boolean @default(true)

  artistId Int
  artist   Professional @relation(fields: [artistId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([isActive])
}

model StudioRequest {
  id Int @id @default(autoincrement())

  type   StudioRequestType
  status StudioRequestStatus @default(NEW)

  name      String
  whatsapp  String
  email     String
  instagram String?

  message String?

  details Json?

  professionalId Int?
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)

  flashId Int?
  flash   Flash? @relation(fields: [flashId], references: [id], onDelete: SetNull)

  artworkId Int?
  artwork   Artwork? @relation(fields: [artworkId], references: [id], onDelete: SetNull)

  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([professionalId])
  @@index([flashId])
  @@index([artworkId])
  @@index([productId])
  @@index([createdAt])
}

model AdminUser {
  id           Int       @id @default(autoincrement())
  name         String
  email        String    @unique
  passwordHash String
  role         AdminRole @default(EDITOR)
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}
